# Application
APP_NAME=AI Internship Agent
DEBUG=true

# PostgreSQL (async SQLAlchemy)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/internship_agent

# Uploaded documents and Ollama structured extraction
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2:1b

# JWT — change JWT_SECRET_KEY before deploying
JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Cookies (set COOKIE_SECURE=true behind HTTPS)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
ACCESS_COOKIE_NAME=access_token
REFRESH_COOKIE_NAME=refresh_token

# Frontend origins for CORS (credentials enabled)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ChromaDB — "http" targets the Docker server, "embedded" writes to vector_db/
CHROMA_MODE=http
CHROMA_HOST=localhost
CHROMA_PORT=6333
